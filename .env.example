# Agent / browser settings
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
TEST_URL=https://quiz-web-wzr7.onrender.com/

USER_SURNAME=YourSurname
USER_NAME=YourName
USER_GROUP=YourGroup

MAX_STEPS=80
ENABLE_VISION=false
HEADLESS=false
MAX_SAME_ACTION=3
TEST_LOAD_TIMEOUT=20
AUTO_SUBMIT=true

# API server settings (use a strong random value locally)
API_TOKEN=replace-with-a-long-random-secret
FRONTEND_ORIGINS=https://browser-agent-web-nine.vercel.app

# URL_POLICY_MODE:
# public_https (default): accept any syntactically valid public HTTPS target,
#   subject to DNS/IP checks and the browser egress proxy.
# strict_allowlist: accept only exact hosts listed in ALLOWED_TEST_HOSTS,
#   while retaining the same public-address and egress protections.
URL_POLICY_MODE=public_https
ALLOWED_TEST_HOSTS=quiz-web-wzr7.onrender.com,browser-agent-web-nine.vercel.app

# Optional: enable Firestore-backed history
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
